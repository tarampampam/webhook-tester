{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node --no-deprecation ./generate/api.js ./../../api/openapi.yml ./src/api/schema.gen.ts",
    "fmt": "npx prettier --write ./*.{js,ts} ./src && npm run lint:es -- --fix",
    "lint": "npm run lint:ts && npm run lint:es",
    "lint:ts": "npx tsc --noEmit",
    "lint:es": "npx eslint ./src/**/*.{ts,tsx}",
    "test": "npx vitest --run",
    "serve": "npx vite dev --clearScreen=false",
    "watch": "npx vite build --watch",
    "build": "npm run lint:ts && npx vite build"
  },
  "dependencies": {
    "@mantine/code-highlight": "^9.6.0",
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@tabler/icons-react": "^3.46.0",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.5",
    "highlight.js": "^11.12.0",
    "motion": "^12.42.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.4",
    "@fetch-mock/vitest": "^0.2.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "happy-dom": "^20.12.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.11"
  },
  "volta": {
    "node": "25"
  },
  "engines": {
    "node": ">=25"
  }
}
